generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is now in prisma.config.ts
}

// ======================
// AUTH & USERS
// ======================

enum Role {
  SUPER_ADMIN
  MANAGEMENT
  PRINCIPAL
  TEACHER
  BURSAR
  HR_ADMIN
  PROCUREMENT
  PARENT
  STUDENT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  staffProfile Staff?
  student      Student?
  parent       Parent?
  auditLogs    AuditLog[]

  @@index([email])
  @@index([role])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ======================
// SCHOOL CORE (Single school ready, multi-campus ready later)
// ======================

model School {
  id        String   @id @default(cuid())
  name      String
  shortName String?
  address   String?
  city      String?
  state     String?
  country   String   @default("Nigeria")
  phone     String?
  email     String?
  website   String?
  logoUrl   String?
  motto     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses    Campus[]
  sessions    AcademicSession[]
  departments Department[]
}

model Campus {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  address   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  classes Class[]
}

// ======================
// ACADEMIC STRUCTURE
// ======================

model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // e.g. "2025/2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School    @relation(fields: [schoolId], references: [id])
  terms    Term[]
  classes  Class[]
  students Student[]

  @@unique([schoolId, name])
}

model Term {
  id        String   @id @default(cuid())
  sessionId String
  name      String // First Term, Second Term, Third Term
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session           AcademicSession    @relation(fields: [sessionId], references: [id])
  assessments       Assessment[]
  attendanceRecords AttendanceRecord[]
}

model Department {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School    @relation(fields: [schoolId], references: [id])
  subjects Subject[]
  staff    Staff[]
}

model Subject {
  id           String   @id @default(cuid())
  departmentId String?
  name         String
  code         String?
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department    Department?    @relation(fields: [departmentId], references: [id])
  classSubjects ClassSubject[]
  assessments   Assessment[]
}

model Class {
  id        String   @id @default(cuid())
  campusId  String?
  sessionId String
  name      String // e.g. "JSS 1", "SS 2"
  level     String? // Junior / Senior
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus        Campus?          @relation(fields: [campusId], references: [id])
  session       AcademicSession  @relation(fields: [sessionId], references: [id])
  sections      ClassSection[]
  students      Student[]
  classSubjects ClassSubject[]
}

model ClassSection {
  id        String   @id @default(cuid())
  classId   String
  name      String // A, B, C...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class         Class          @relation(fields: [classId], references: [id])
  students      Student[]
  classSubjects ClassSubject[]
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  sectionId String?
  subjectId String
  teacherId String? // Staff id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class         @relation(fields: [classId], references: [id])
  section ClassSection? @relation(fields: [sectionId], references: [id])
  subject Subject       @relation(fields: [subjectId], references: [id])
  teacher Staff?        @relation(fields: [teacherId], references: [id])
}

// ======================
// STUDENTS & GUARDIANS
// ======================

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  SUSPENDED
  WITHDRAWN
}

model Student {
  id               String        @id @default(cuid())
  userId           String?       @unique // optional linked user account
  admissionNumber  String        @unique
  firstName        String
  lastName         String
  middleName       String?
  gender           String?
  dateOfBirth      DateTime?
  bloodGroup       String?
  nationality      String?       @default("Nigerian")
  religion         String?
  address          String?
  photoUrl         String?
  status           StudentStatus @default(ACTIVE)
  admissionDate    DateTime?
  currentClassId   String?
  currentSectionId String?
  sessionId        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user           User?             @relation(fields: [userId], references: [id])
  currentClass   Class?            @relation(fields: [currentClassId], references: [id])
  currentSection ClassSection?     @relation(fields: [currentSectionId], references: [id])
  session        AcademicSession?  @relation(fields: [sessionId], references: [id])

  guardians    StudentGuardian[]
  documents    StudentDocument[]
  assessments  StudentAssessment[]
  attendance   AttendanceRecord[]
  feeInvoices  FeeInvoice[]
  applications AdmissionApplication[]

  @@index([admissionNumber])
  @@index([status])
  @@index([currentClassId])
}

model Parent {
  id         String   @id @default(cuid())
  userId     String?  @unique
  firstName  String
  lastName   String
  phone      String?
  email      String?
  address    String?
  occupation String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?             @relation(fields: [userId], references: [id])
  students StudentGuardian[]
}

model StudentGuardian {
  id           String  @id @default(cuid())
  studentId    String
  parentId     String
  relationship String // Father, Mother, Guardian
  isPrimary    Boolean @default(false)

  student Student @relation(fields: [studentId], references: [id])
  parent  Parent  @relation(fields: [parentId], references: [id])

  @@unique([studentId, parentId])
}

model StudentDocument {
  id         String   @id @default(cuid())
  studentId  String
  name       String
  type       String // Birth Certificate, Transfer Certificate, etc.
  fileUrl    String
  uploadedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
}

// ======================
// ADMISSIONS
// ======================

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ADMITTED
  WITHDRAWN
}

model AdmissionApplication {
  id            String            @id @default(cuid())
  studentId     String? // created after admission
  applicationNo String            @unique
  firstName     String
  lastName      String
  middleName    String?
  gender        String?
  dateOfBirth   DateTime?
  applyingClass String?
  parentName    String?
  parentPhone   String?
  parentEmail   String?
  status        ApplicationStatus @default(SUBMITTED)
  documents     Json? // array of uploaded docs metadata
  notes         String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  student Student? @relation(fields: [studentId], references: [id])
}

// ======================
// EXAMS & RESULTS
// ======================

model Assessment {
  id             String    @id @default(cuid())
  termId         String
  subjectId      String
  name           String // CA1, CA2, Exam, etc.
  maxScore       Float
  weight         Float? // percentage contribution
  assessmentDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  term    Term                @relation(fields: [termId], references: [id])
  subject Subject             @relation(fields: [subjectId], references: [id])
  scores  StudentAssessment[]
}

model StudentAssessment {
  id           String   @id @default(cuid())
  studentId    String
  assessmentId String
  score        Float?
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    Student    @relation(fields: [studentId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([studentId, assessmentId])
}

// ======================
// FEES & FINANCE (Paystack ready)
// ======================

model FeeStructure {
  id          String   @id @default(cuid())
  name        String // Tuition, Development Levy, etc.
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  classId     String? // null = school-wide
  sessionId   String?
  termId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices FeeInvoiceItem[]
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model FeeInvoice {
  id            String        @id @default(cuid())
  studentId     String
  invoiceNumber String        @unique
  totalAmount   Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  balance       Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime?
  sessionId     String?
  termId        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student  Student          @relation(fields: [studentId], references: [id])
  items    FeeInvoiceItem[]
  payments Payment[]
}

model FeeInvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  feeStructureId String?
  description    String
  amount         Decimal @db.Decimal(12, 2)

  invoice      FeeInvoice    @relation(fields: [invoiceId], references: [id])
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  PAYSTACK
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id                 String        @id @default(cuid())
  invoiceId          String
  amount             Decimal       @db.Decimal(12, 2)
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  paystackRef        String?       @unique // Paystack reference
  paystackAccessCode String?
  receiptNumber      String?       @unique
  paidAt             DateTime?
  recordedById       String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id])
}

// ======================
// ATTENDANCE
// ======================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  studentId  String
  termId     String
  date       DateTime         @db.Date
  status     AttendanceStatus
  remark     String?
  markedById String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, date])
  @@index([date])
}

// ======================
// HR / STAFF
// ======================

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
}

model Staff {
  id             String           @id @default(cuid())
  userId         String?          @unique
  staffNumber    String           @unique
  firstName      String
  lastName       String
  middleName     String?
  gender         String?
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  address        String?
  departmentId   String?
  designation    String? // Teacher, Bursar, Principal...
  employmentDate DateTime?
  status         EmploymentStatus @default(ACTIVE)
  photoUrl       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user          User?          @relation(fields: [userId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  classSubjects ClassSubject[]
}

// ======================
// PROCUREMENT & INVENTORY (Foundation)
// ======================

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseRequest {
  id            String                @id @default(cuid())
  requestNo     String                @unique
  requestedById String?
  status        PurchaseRequestStatus @default(DRAFT)
  totalAmount   Decimal?              @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  items PurchaseRequestItem[]
}

model PurchaseRequestItem {
  id                String  @id @default(cuid())
  purchaseRequestId String
  description       String
  quantity          Int
  unitPrice         Decimal @db.Decimal(12, 2)
  total             Decimal @db.Decimal(12, 2)

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  orderNo     String    @unique
  supplierId  String?
  status      String
  totalAmount Decimal   @db.Decimal(12, 2)
  orderedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier Supplier? @relation(fields: [supplierId], references: [id])
}

model InventoryItem {
  id        String   @id @default(cuid())
  name      String
  sku       String?  @unique
  category  String?
  quantity  Int      @default(0)
  unit      String?
  minStock  Int?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}